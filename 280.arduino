#include <Adafruit_BME280.h>

// Presión atmosférica al nivel del mar (valor estándar)
#define SEALEVELPRESSURE_HPA (1013.25) 

// Inicialización de la librería (Comunicación por I2C)
Adafruit_BME280 bme; 

// Variables para almacenar los datos
float temperatura, humedad, presion, altitud; 

void setup() {
  Serial.begin(9600); // Inicia el monitor serie a 9600 baudios
  
  // Inicia el sensor. Nota: 0x76 es la dirección I2C común
  if (!bme.begin(0x76)) {
    Serial.println("¡No se encuentra el sensor BME280! Revisa las conexiones.");
    while (1);
  }
}

void loop() {
  // Lectura de los valores del sensor
  temperatura = bme.readTemperature(); 
  humedad = bme.readHumidity();       
  presion = bme.readPressure() / 100.0F; // Convierte Pascales a hPa
  altitud = bme.readAltitude(SEALEVELPRESSURE_HPA);

  // Imprimir los valores en el monitor serie en español
  Serial.print("Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" °C");

  Serial.print("Humedad: ");
  Serial.print(humedad);
  Serial.println(" %");

  Serial.print("Presión: ");
  Serial.print(presion);
  Serial.println(" hPa");

  Serial.print("Altitud aprox: ");
  Serial.print(altitud);
  Serial.println(" m");

  Serial.println("-----------------------"); // Separador
  delay(2000); // Espera 2 segundos antes de la siguiente lectura
}
